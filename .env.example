# Copy to .env.local at the repository root. Never commit real credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Local-only Docker Desktop Iris actions; enable after installing the operator.
LOCAL_OPERATOR_ENABLED=0
# Private owner panel: local (default), rehearsal, or eks. Never expose this API publicly.
OWNER_CLUSTER_TARGET=local
REHEARSAL_RECEIPT=
EKS_AWS_PROFILE=
EKS_EXPECTED_ACCOUNT=
EKS_RELEASE_RECEIPT=
# Set this in the frontend build environment (Vercel or frontend/.env.local),
# not this backend environment file, when the API runs at another origin:
# VITE_API_BASE_URL=https://your-backend.example
