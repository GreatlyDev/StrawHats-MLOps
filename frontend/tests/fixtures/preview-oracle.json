            }
          },
          "spec": {
            "replicas": 1,
            "revisionHistoryLimit": 3,
            "selector": {
              "matchLabels": {
                "app.kubernetes.io/name": "iris-preview"
              }
            },
            "template": {
              "metadata": {
                "labels": {
                  "app.kubernetes.io/name": "iris-preview",
                  "app.kubernetes.io/managed-by": "strawhats"
                },
                "annotations": {
                  "prometheus.io/scrape": "true",
                  "prometheus.io/path": "/metrics",
                  "prometheus.io/port": "8000"
                }
              },
              "spec": {
                "containers": [
                  {
                    "name": "model",
