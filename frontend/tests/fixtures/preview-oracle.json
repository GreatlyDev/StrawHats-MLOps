                        "memory": "256Mi"
                      }
                    },
                    "readinessProbe": {
                      "httpGet": {
                        "path": "/health",
                        "port": 8000
                      },
                      "initialDelaySeconds": 10,
                      "periodSeconds": 5
                    },
                    "livenessProbe": {
                      "httpGet": {
                        "path": "/health",
                        "port": 8000
                      },
                      "initialDelaySeconds": 30,
                      "periodSeconds": 10
                    },
                    "securityContext": {
                      "allowPrivilegeEscalation": false,
                      "capabilities": {
                        "drop": [
                          "ALL"
                        ]
                      }
                    }
                  }
                ],
                "securityContext": {
                  "runAsNonRoot": true,
                  "runAsUser": 10001
                }
              }
            }
          }
        },
        {
          "apiVersion": "v1",
          "kind": "Service",
          "metadata": {
            "name": "iris-preview",
            "namespace": "strawhats"
          },
          "spec": {
            "selector": {
              "app.kubernetes.io/name": "iris-preview"
            },
            "ports": [
              {
                "port": 80,
                "targetPort": 8000
              }
            ],
            "type": "ClusterIP"
          }
        }
      ]
