FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
WORKDIR /app
COPY backend/requirements-model.txt backend/requirements-model.txt
RUN pip install --no-cache-dir -r backend/requirements-model.txt && useradd --uid 10001 --create-home appuser
COPY backend/__init__.py backend/serve_model.py backend/
COPY backend/app/__init__.py backend/app/models.py backend/app/schemas.py backend/app/store.py backend/app/
USER 10001
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "backend.serve_model:create_model_service", "--factory", "--host", "0.0.0.0", "--port", "8000", "--http", "h11", "--ws", "none"]
