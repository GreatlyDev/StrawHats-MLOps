{
  "id": null,
  "uid": "strawhats-local-iris",
  "title": "StrawHats — Local Iris monitoring",
  "tags": ["strawhats", "local", "iris"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Scrape and class telemetry",
      "type": "stat",
      "description": "All Iris targets must scrape successfully and expose all three class counters. A missing metric is unavailable.",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          },
          "expr": "iris:telemetry_available",
          "refId": "A",
          "legendFormat": "Telemetry",
          "instant": true,
          "range": false,
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          },
          "expr": "iris:target_count",
          "refId": "B",
          "legendFormat": "Discovered Iris targets",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "noValue": "No current data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Unavailable",
                        "color": "red"
                      },
                      "1": {
                        "text": "Available",
                        "color": "green"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value"
      }
    },
    {
      "id": 2,
      "title": "Prediction rate (successful predictions/s)",
      "type": "timeseries",
      "description": "Measured successful inference rate across individual Iris Pods over two minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          },
          "expr": "sum(rate(strawhats_model_predictions_total{job=\"iris-model\"}[2m]))",
          "refId": "A",
          "legendFormat": "Predictions/s",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "noValue": "No current data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 3,
      "title": "Model processing latency — estimated p95",
      "type": "timeseries",
      "description": "Histogram estimate of model processing time. No observations means no latency estimate; proxy/network overhead is excluded.",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          },
          "expr": "1000 * histogram_quantile(0.95, sum by(le)(rate(strawhats_model_prediction_seconds_bucket{job=\"iris-model\"}[2m])))",
          "refId": "A",
          "legendFormat": "Estimated p95",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "noValue": "No current data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 4,
      "title": "Recent prediction distribution and sample count",
      "type": "timeseries",
      "description": "Shares over two minutes. A concentration warning needs >90% one class and at least 20 recent predictions for 30s. This does not measure accuracy loss.",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          },
          "expr": "iris:class_share:ratio2m",
          "refId": "A",
          "legendFormat": "{{label}}",
          "instant": false,
          "range": true,
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          },
          "expr": "iris:predictions:increase2m",
          "refId": "B",
          "legendFormat": "Recent predictions (estimated)",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "noValue": "No current data",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "A" },
            "properties": [{ "id": "max", "value": 1 }]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.axisLabel",
                "value": "Estimated predictions in 2m"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 5,
      "title": "Serving process CPU (cores)",
      "type": "timeseries",
      "description": "Linux serving-process CPU seconds per second, in cores. Pod totals are separately available from kubectl top.",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          },
          "expr": "rate(process_cpu_seconds_total{job=\"iris-model\"}[2m])",
          "refId": "A",
          "legendFormat": "{{pod}}",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "noValue": "No current data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 6,
      "title": "Serving process resident memory (MiB)",
      "type": "timeseries",
      "description": "Linux process resident memory. This is distinct from pod working-set memory.",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          },
          "expr": "process_resident_memory_bytes{job=\"iris-model\"} / 1024 / 1024",
          "refId": "A",
          "legendFormat": "{{pod}}",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "noValue": "No current data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 7,
      "title": "Distribution warning",
      "type": "stat",
      "description": "A concentration indicator only. Recovery requires available telemetry and sufficient recent samples; missing data never proves recovery.",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          },
          "expr": "((1 + (max(ALERTS{alertname=\"IrisPredictionDistributionSkew\",alertstate=\"pending\"}) or vector(0)) + 2 * (max(ALERTS{alertname=\"IrisPredictionDistributionSkew\",alertstate=\"firing\"}) or vector(0))) and on() (iris:telemetry_available == 1) and on() (iris:predictions:increase2m >= 20)) or (vector(0) and on() (iris:telemetry_available == 1)) or vector(-1)",
          "refId": "A",
          "legendFormat": "Current state",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "noValue": "No current data",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Insufficient observations",
                  "color": "blue"
                },
                "1": {
                  "text": "Normal distribution",
                  "color": "green"
                },
                "2": {
                  "text": "Pending warning",
                  "color": "orange"
                },
                "3": {
                  "text": "Concentration warning firing",
                  "color": "red"
                },
                "-1": {
                  "text": "Telemetry unavailable",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value"
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
